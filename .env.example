# AML Monitor — Environment Variables
# Copy to .env and fill in values

# PostgreSQL
# IMPORTANT: Replace with your actual database credentials
# For Docker: use service name 'postgres' as host
DATABASE_URL=postgresql+asyncpg://aml:YOUR_SECURE_PASSWORD@localhost:5432/aml_monitor
DATABASE_URL_SYNC=postgresql://aml:YOUR_SECURE_PASSWORD@localhost:5432/aml_monitor

# Redis
REDIS_URL=redis://localhost:6379/0

# API Security
# Generate secure API keys for production
API_KEYS=dev-api-key-1,dev-api-key-2

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# App
APP_NAME=AML Monitor
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000