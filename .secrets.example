# Secrets file (do not commit to git!)
# Copy this file to .secrets and fill in your values

# PostgreSQL password (minimum 16 characters recommended)
POSTGRES_PASSWORD=change_me_in_production

# API keys (generate secure random strings)
API_KEYS=your_api_key_1,your_api_key_2

# Backend JWT secret (for future auth)
JWT_SECRET=change_this_in_production
